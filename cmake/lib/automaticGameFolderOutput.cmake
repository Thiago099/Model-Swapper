
function(automaticGameFolderOutput wildlander_output steam_owrt_output steam_mods_output)
    cmake_parse_arguments(OUTPUT "" "TARGET;COMMAND_TARGET;DISPLAY_NAME;SUBDIRECTORY" "" ${ARGN})
    if(NOT OUTPUT_TARGET)
        set(OUTPUT_TARGET "${PROJECT_NAME}")
    endif()
    if(NOT OUTPUT_COMMAND_TARGET)
        set(OUTPUT_COMMAND_TARGET "${OUTPUT_TARGET}")
    endif()
    if(NOT OUTPUT_DISPLAY_NAME)
        set(OUTPUT_DISPLAY_NAME "${BEAUTIFUL_NAME}")
    endif()
    if(NOT DEFINED OUTPUT_SUBDIRECTORY)
        set(OUTPUT_SUBDIRECTORY "SKSE/Plugins")
    endif()

    if(DEFINED ENV{SKYRIM_FOLDER} AND IS_DIRECTORY "$ENV{SKYRIM_FOLDER}/Data")
        copyOutputs("$ENV{SKYRIM_FOLDER}/Data" TARGET "${OUTPUT_TARGET}" COMMAND_TARGET "${OUTPUT_COMMAND_TARGET}" SUBDIRECTORY "${OUTPUT_SUBDIRECTORY}")
    endif()
    if(DEFINED ENV{WILDLANDER_OWRT_FOLDER} AND IS_DIRECTORY "$ENV{WILDLANDER_OWRT_FOLDER}" AND wildlander_output)
        copyOutputs("$ENV{WILDLANDER_OWRT_FOLDER}/${OUTPUT_DISPLAY_NAME}${PROJECT_SUFFIX}" TARGET "${OUTPUT_TARGET}" COMMAND_TARGET "${OUTPUT_COMMAND_TARGET}" SUBDIRECTORY "${OUTPUT_SUBDIRECTORY}")
    endif()
    if(DEFINED ENV{SKYRIM_OWRT_FOLDER} AND IS_DIRECTORY "$ENV{SKYRIM_OWRT_FOLDER}" AND steam_owrt_output)
        copyOutputs("$ENV{SKYRIM_OWRT_FOLDER}/${OUTPUT_DISPLAY_NAME}${PROJECT_SUFFIX}" TARGET "${OUTPUT_TARGET}" COMMAND_TARGET "${OUTPUT_COMMAND_TARGET}" SUBDIRECTORY "${OUTPUT_SUBDIRECTORY}")
    endif()
    if(DEFINED ENV{SKYRIM_MODS_FOLDER} AND IS_DIRECTORY "$ENV{SKYRIM_MODS_FOLDER}" AND steam_mods_output)
        copyOutputs("$ENV{SKYRIM_MODS_FOLDER}/${OUTPUT_DISPLAY_NAME}${PROJECT_SUFFIX}" TARGET "${OUTPUT_TARGET}" COMMAND_TARGET "${OUTPUT_COMMAND_TARGET}" SUBDIRECTORY "${OUTPUT_SUBDIRECTORY}")
    endif()
    if(DEFINED ENV{SKYRIM_MODS_FOLDER2} AND IS_DIRECTORY "$ENV{SKYRIM_MODS_FOLDER2}" AND steam_mods_output)
        copyOutputs("$ENV{SKYRIM_MODS_FOLDER2}/${OUTPUT_DISPLAY_NAME}${PROJECT_SUFFIX}" TARGET "${OUTPUT_TARGET}" COMMAND_TARGET "${OUTPUT_COMMAND_TARGET}" SUBDIRECTORY "${OUTPUT_SUBDIRECTORY}")
    endif()

endfunction()
